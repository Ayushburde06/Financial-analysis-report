# Azure Document Intelligence (OCR)
AZURE_DOC_INTEL_ENDPOINT=https://your-resource.cognitiveservices.azure.com/
AZURE_DOC_INTEL_KEY=your-azure-doc-intel-key

# Optional Azure Mistral OCR for difficult chart-heavy scanned PDFs
AZURE_MISTRAL_OCR_ENDPOINT=https://your-resource.services.ai.azure.com/providers/mistral/azure/ocr
AZURE_MISTRAL_OCR_KEY=your-azure-mistral-ocr-key
AZURE_MISTRAL_OCR_DEPLOYMENT=mistral-document-ai-2512

# AWS Bedrock (unused while GPT-5.6 Luna handles post-OCR LLM work)
AWS_BEARER_TOKEN_BEDROCK=your-aws-bearer-token

# Azure OpenAI — GPT-5.6 Luna (extraction + narrative after OCR)
AZURE_GPT5_ENDPOINT=https://your-resource.openai.azure.com/openai/v1
AZURE_GPT5_KEY=your-azure-openai-key
AZURE_GPT5_DEPLOYMENT=gpt-5.6-luna

# DeepSeek V4 Pro — fallback / parallel multimodel partner
USE_DEEPSEEK_V4=1

# Run Luna + DeepSeek in parallel for extraction and narrative (set 0 for sequential)
USE_MULTIMODEL=1

# Azure DeepSeek (used only as Luna fallback)
AZURE_DEEPSEEK_ENDPOINT=https://your-resource.openai.azure.com
AZURE_DEEPSEEK_DEPLOYMENT=DeepSeek-V4-Pro
AZURE_DEEPSEEK_KEY=your-azure-deepseek-key
AZURE_DEEPSEEK_API_VERSION=2025-01-01-preview

# Maximum seconds per model request (default: 60)
LLM_REQUEST_TIMEOUT=60
LLM_EXTRACTION_TIMEOUT=120
LLM_MAX_ATTEMPTS=2

# Stage 01 OCR: split PDF per page, Azure Layout → Markdown
# OCR_CHARTS=1 re-OCRs figure-heavy pages as images so chart labels enter Markdown
OCR_PER_PAGE=1
OCR_MARKDOWN=1
OCR_CHARTS=1
OCR_MAX_WORKERS=4
OCR_MAX_PAGES=120

# OCR and rendering defaults
PREFER_LOCAL_PDF_TEXT=0
PER_PAGE_OCR=0
PDF_RENDER_SETTLE_MS=500

# Deployment hardening
ENVIRONMENT=production
GENERATE_RATE_LIMIT=20
GENERATE_RATE_WINDOW_SECONDS=600
